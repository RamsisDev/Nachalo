(* Appointment mode (spec sections 6.2 and 11.2) when A's words leak: B's words must still admit
   no offline test. The rendezvous id comes from A's words only, so it is published. *)

free context: bitstring.
free at: bitstring.
free payload_a, payload_b, secret_a, secret_b: bitstring [private].
free wa: bitstring.
free wb: bitstring [private].
weaksecret wb.

let Appointment(words_a: bitstring, words_b: bitstring, publish_rendezvous: bool) =
  new sas: channel; new sas_ok: channel; new qk: bitstring; new qk_kem: bitstring;
  let prs = (words_a, words_b) in
  let ci = (PROTOCOL, context, L_APPOINTMENT, at) in
  (if publish_rendezvous then out(c, hkdf(ci, hkdf(ci, words_a, L_RV_TAG), L_RV)))
  | (!Initiator(prs, ci, payload_a, secret_a, sas, sas_ok, qk, qk_kem))
  | (!Responder(prs, ci, payload_b, secret_b, sas, sas_ok, qk, qk_kem)).

process Appointment(wa, wb, true)

(* Expected results:
RESULT Weak secret wb is true.
*)
