(* Physical-token mode (spec section 6.3). The token is a 256-bit secret and its expiry, and
   the rendezvous id, derived from it, is published. *)

free context: bitstring.
free expires: bitstring.

(* The attacker read the token, not the words. *)
free token_read: bitstring.
free words: bitstring [private].

(* The attacker learned the words, not the token. *)
free token: bitstring [private].
free words_leaked: bitstring.

free payload_a, payload_b, secret_a, secret_b: bitstring [private].

weaksecret words.

(* With the words but not the token, the attacker cannot complete a handshake. *)
query attacker(token).
query attacker(payload_a).
query attacker(payload_b).
query attacker(secret_a).
query attacker(secret_b).
query p: bitstring, ci: bitstring, m1: bitstring, m2: bitstring, m3: bitstring;
  inj-event(AFinished(p, ci, m1, m2, m3)) ==> inj-event(BResponded(p, ci, m1, m2)).
query p: bitstring, ci: bitstring, m1: bitstring, m2: bitstring, m3: bitstring;
  inj-event(BFinished(p, ci, m1, m2, m3)) ==> inj-event(AFinished(p, ci, m1, m2, m3)).

query p: bitstring, ci: bitstring, th: bitstring, k: bitstring; event(BConfirmed(p, ci, th, k)).

(* B, who received the token, starts; A, who made it, answers. The roles of the library do not
   depend on who made the invitation. *)
let PhysicalToken(w: bitstring, tsecret: bitstring, pa: bitstring, pb: bitstring, sa: bitstring,
                  sb: bitstring) =
  new sas: channel; new sas_ok: channel; new qk: bitstring; new qk_kem: bitstring;
  let tok = (tsecret, expires) in
  let ci = (PROTOCOL, context, L_TOKEN) in
  out(c, hkdf(ci, tok, L_RV));
  (!Initiator((w, tok), ci, pa, sa, sas, sas_ok, qk, qk_kem))
  | (!Responder((w, tok), ci, pb, sb, sas, sas_ok, qk, qk_kem)).

process
  PhysicalToken(words, token_read, payload_a, payload_b, secret_a, secret_b)
  | PhysicalToken(words_leaked, token, payload_a, payload_b, secret_a, secret_b)

(* Expected results:
RESULT Weak secret words is true.
RESULT not attacker(token[]) is true.
RESULT not attacker(payload_a[]) is true.
RESULT not attacker(payload_b[]) is true.
RESULT not attacker(secret_a[]) is true.
RESULT not attacker(secret_b[]) is true.
RESULT inj-event(AFinished(p,ci_2,m1,m2,m3)) ==> inj-event(BResponded(p,ci_2,m1,m2)) is true.
RESULT inj-event(BFinished(p,ci_2,m1,m2,m3)) ==> inj-event(AFinished(p,ci_2,m1,m2,m3)) is true.
RESULT not event(BConfirmed(p,ci_2,th_4,k)) is false.
*)
